# Web app build-time settings (Vite). Copy to .env.local only if you need them; the defaults suit local
# development (`npm run dev` proxies /api to the server on :8080) and single-service deploys (the server serves
# the web app and the API from one origin).
#
# Server settings live in server/.env.example.

# Origin of the API when the web app is hosted separately (e.g. static hosting on Vercel/Netlify, API elsewhere).
# Leave empty when the API is on the same origin. No trailing slash, no /api suffix.
VITE_API_URL=

# Public origin used in links people share or copy (passport links, connect codes). Defaults to the page's own
# origin, which is right for the web; native builds must set it (see .env.capacitor.example).
VITE_PUBLIC_APP_URL=
