{
  "name": "loopin",
  "private": true,
  "version": "1.0.0",
  "description": "Loopin by Genesis Hacks — verified developer passport and in-person networking for hackathons.",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "shared",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev -w @loopin/server",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "npm run build -w @loopin/server",
    "start": "npm run start -w @loopin/server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck -w @loopin/shared && npm run typecheck -w @loopin/server",
    "test": "npm run test:web && npm run test -w @loopin/shared && npm run test -w @loopin/server",
    "test:web": "vitest run",
    "db:migrate": "npm run db:migrate -w @loopin/server",
    "db:seed": "npm run db:seed -w @loopin/server",
    "keys:generate": "npm run keys:generate -w @loopin/server",
    "cap:sync": "npm run build:cap && cap sync",
    "build:cap": "tsc --noEmit && vite build --mode capacitor",
    "admin:grant": "npm run admin:grant -w @loopin/server --"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@loopin/shared": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tanstack/query-sync-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.45.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
