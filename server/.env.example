# Loopin API server configuration.
#
# Copy to server/.env for local overrides (loaded automatically when present; real environment variables win).
# In development nothing here is required: an embedded database (PGlite) and development secrets are created
# under server/.data/ on first start. In production the server refuses to start without NODE_ENV=production
# plus APP_URL, QR_SECRET, SIGNING_KEY and a database (DATABASE_URL, or PGLITE_DIR on a persistent volume).
# The values below are examples — never commit real secrets.

# --- Runtime -------------------------------------------------------------------------------------------------

# development | production | test. When unset: development for `tsx src/…` (npm run dev), production for
# the built bundle (node dist/index.js). Vitest sets test.
# NODE_ENV=production

# HTTP port.
PORT=8080

# fatal | error | warn | info | debug | trace | silent  (default: info; warn under NODE_ENV=test)
# LOG_LEVEL=info

# --- Public URLs ---------------------------------------------------------------------------------------------

# Public address of the web app (required in production; should be https). Email links and OAuth redirects
# point here. Default: http://localhost:5173
# APP_URL=https://loopin.example.com

# Public address of this API, used to build the GitHub OAuth callback URL. Default: APP_URL.
# API_URL=https://api.loopin.example.com

# Extra origins allowed to call the API from a browser (comma separated). Always allowed: APP_URL's origin,
# http://localhost:5173, http://127.0.0.1:5173, capacitor://localhost, https://localhost, http://localhost.
# CORS_ORIGINS=https://preview.loopin.example.com

# --- Database ------------------------------------------------------------------------------------------------

# PostgreSQL connection string (PostgreSQL 15+). When unset, the embedded PGlite database is used.
# DATABASE_URL=postgres://loopin:change-me@localhost:5432/loopin

# TLS for DATABASE_URL: true (verify the certificate) | no-verify (encrypt, skip verification) | false.
# When set it overrides any sslmode in the URL; when unset the URL's sslmode applies.
# DATABASE_SSL=true

# PGlite data directory (relative paths are resolved against server/). Default: server/.data/pglite.
# Use memory:// for a throwaway in-memory database. In production without DATABASE_URL this must point at a
# persistent volume, and only ONE server instance may use it (a lock file next to it, <dir>.lock, enforces this,
# so use a subdirectory of the volume such as /data/pglite, not the mount point itself).
# PGLITE_DIR=/data/pglite

# --- Secrets (generate with: npm run keys:generate) ----------------------------------------------------------

# ≥ 32 random bytes, base64 or base64url. Derives every user's badge key and signs connect tickets.
# Changing it invalidates all badge codes and connect links at once.
# QR_SECRET=replace-with-output-of-npm-run-keys-generate

# 32-byte Ed25519 seed, base64 or base64url. Signs stamps and awards.
# SIGNING_KEY=replace-with-output-of-npm-run-keys-generate

# Retired signing public keys (base64url, comma separated) so credentials signed before a key change still
# verify. Take the old value from GET /api/keys → publicKey before replacing SIGNING_KEY.
# SIGNING_PUBLIC_KEYS_PREVIOUS=

# --- Accounts ------------------------------------------------------------------------------------------------

# Sliding session lifetime in days (1–90). Sessions never outlive 90 days after sign-in.
# SESSION_TTL_DAYS=30

# Emails that become admin once the address is verified (verified GitHub primary email, or after a completed
# password reset). Never applied on plain signup or login. Comma separated.
# ADMIN_EMAILS=you@example.com

# Demo data for an empty database: true (default in development) | false | force (also outside development;
# every demo account is then a plain member and DEMO_PASSWORD is required).
# SEED_DEMO=true

# Password of the demo accounts. Default in development: loopin-demo.
# DEMO_PASSWORD=

# --- Email ---------------------------------------------------------------------------------------------------

# SMTP server for password-reset emails. Without it, development prints emails to the log and other
# environments turn "forgot password" off.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Loopin <no-reply@loopin.example.com>

# --- GitHub sign-in (web only) -------------------------------------------------------------------------------

# Create an OAuth app with the callback URL <API_URL>/api/auth/github/callback. Set both or neither.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Networking ----------------------------------------------------------------------------------------------

# Proxies in front of the server, so client IPs (rate limits) are read correctly:
#   false/0 (default) · a hop count, e.g. 1 for Railway/Render/Fly · comma list of IPs/CIDRs or loopback,
#   linklocal, uniquelocal · true (trust everything; refused in production).
# TRUST_PROXY=1

# Serve the web build (WEB_DIST_DIR, default: repo-root dist/) with SPA fallback when it exists.
# SERVE_WEB=true
# WEB_DIST_DIR=../dist

# Maximum concurrent live streams (GET /api/stream) for the whole server; extra connections get 503.
# STREAM_MAX=5000

# --- Rate limits (per window; defaults shown) ----------------------------------------------------------------

# All API requests, per minute: per signed-in user / per anonymous IP.
# RATE_LIMIT_API_USER=600
# RATE_LIMIT_API_IP=3000
# Logins per 15 minutes: failed attempts per IP + email / all attempts per IP.
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_IP=300
# Signups per 15 minutes per IP.
# RATE_LIMIT_SIGNUP_IP=200
# Password-reset emails per 15 minutes per IP + email; reset submissions per 15 minutes per IP.
# RATE_LIMIT_FORGOT=5
# RATE_LIMIT_RESET=5
# GitHub sign-in code exchanges per 15 minutes per IP.
# RATE_LIMIT_OAUTH_IP=100
# Profile exchanges per minute per user; organizer check-ins per minute per user; badge previews per minute per IP.
# RATE_LIMIT_EXCHANGE_USER=60
# RATE_LIMIT_CHECKIN_USER=240
# RATE_LIMIT_PREVIEW_IP=300
# Rate limiting is off under NODE_ENV=test unless this is set (used by the rate-limit tests).
# RATE_LIMIT_IN_TESTS=1

# --- Tests ---------------------------------------------------------------------------------------------------

# Read from the shell/CI environment by test/helpers.ts (this file is not loaded by the test runner).
# Run the suite against PostgreSQL instead of in-memory PGlite; the user must be allowed to CREATE DATABASE
# (every test file gets a fresh database, dropped afterwards):
#   TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres npm run test -w @loopin/server
# Show server logs while testing (default: silent):
#   TEST_LOG_LEVEL=debug
