# Settings for native builds: `npm run build:cap` runs `vite build --mode capacitor`, which reads .env.capacitor.
# Copy this file to .env.capacitor and fill in both values. The app refuses to start without VITE_API_URL,
# because inside the native shell it runs from the device and has no server of its own.

# Your deployed API origin (https). The server must allow the native origins (capacitor://localhost and
# https://localhost are always allowed by its CORS settings).
VITE_API_URL=https://loopin.example.com

# Public web origin for shared links (passport links and connect codes must open in a browser for others).
VITE_PUBLIC_APP_URL=https://loopin.example.com
